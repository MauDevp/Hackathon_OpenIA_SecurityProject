{
  "name": "dmsecurity",
  "version": "0.1.0",
  "description": "DMsecurity: offline, deterministic and verifiable scan of a Git commit for vulnerable dependencies and leaked secrets, built on OSV-Scanner and Gitleaks.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "guardia": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx 'tests/**/*.test.ts'",
    "clean": "rm -rf dist",
    "setup": "npm run build && bash scripts/setup.sh",
    "scan": "GUARDIA_OSV_SCANNER_BIN=$PWD/.guardia/tools/osv-scanner GUARDIA_GITLEAKS_BIN=$PWD/.guardia/tools/gitleaks OSV_SCANNER_LOCAL_DB_CACHE_DIRECTORY=$PWD/.guardia/osv-db node dist/cli/index.js scan",
    "scan:scheduled": "bash scripts/scheduled-scan.sh"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.20.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MauDevp/Hackathon_OpenIA_SecurityProject.git"
  },
  "keywords": [
    "security",
    "sca",
    "sast",
    "offline",
    "osv",
    "sarif",
    "git"
  ],
  "dependencies": {
    "@types/qrcode-terminal": "^0.12.2",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "qrcode-terminal": "^0.12.0"
  }
}
